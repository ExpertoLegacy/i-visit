# Server
PORT=3000
SITE_NAME=Guard House
APP_TZ=Asia/Manila

# Public address printed into the QR codes. Leave blank to use the address
# the admin page is opened from (set this before printing if you use a domain).
# PUBLIC_BASE_URL=https://visitors.example.com

# Storage
# DB_PATH=data/app.db

# Backups: one copy a day while the server runs. Use another drive if you can.
# BACKUP_DIR=E:/guardhouse-backups
# BACKUP_KEEP=14

# SMS to contact persons (off unless SMS_URL is set). See "SMS notifications" in the README.
# SMS_URL=https://sms-provider.example.com/send
# SMS_FORMAT=form
# SMS_TO_FIELD=number
# SMS_MESSAGE_FIELD=message
# SMS_EXTRA=apikey=your-key&sendername=GUARD
# SMS_AUTH_HEADER=Bearer your-token

# First-run admin password (used only when the admin account is created)
# ADMIN_PASSWORD=change-me-please

# Load sample guard/office accounts and a demo print batch (development only)
# SEED_DEMO=1

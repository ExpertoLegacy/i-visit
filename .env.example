# Server
PORT=3000
SITE_NAME=Guard House
APP_TZ=Asia/Manila

# Public address printed into the QR codes. Leave blank to use the address
# the admin page is opened from (set this before printing if you use a domain).
# PUBLIC_BASE_URL=https://visitors.example.com

# Storage
# DB_PATH=data/app.db

# First-run admin password (used only when the admin account is created)
# ADMIN_PASSWORD=change-me-please

# Load sample guard/office accounts and a demo print batch (development only)
# SEED_DEMO=1
